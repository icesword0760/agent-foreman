#!/usr/bin/env node
// Deterministic process tree for network tests, including sandboxed test runners.
import fs from 'node:fs';
import path from 'node:path';
const dir = process.env.FAKE_CODEX_STATE_DIR;
try {
  const calls = fs.readFileSync(path.join(dir, 'calls.jsonl'), 'utf8').trim().split('\n').map(JSON.parse);
  const root = calls.at(-1).pid;
  console.log(`${root} 1`);
  try { console.log(`${fs.readFileSync(path.join(dir, 'worker.pid'), 'utf8')} ${root}`); } catch {}
} catch {}
